# Referência para revisão. Não substituir o virtual host ativo automaticamente.
# Instalação atual: upstream 8040. Piloto isolado proposto: 8041.
server {
    listen 80;
    server_name jumbi.nabio.pro;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name jumbi.nabio.pro;
    ssl_certificate /etc/letsencrypt/live/jumbi.nabio.pro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jumbi.nabio.pro/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    client_max_body_size 18M;
    location /static/ {
        alias /srv/jumbi/current/staticfiles/;
        add_header X-Content-Type-Options nosniff always;
    }
    location /media/ {
        alias /srv/jumbi/shared/media/;
        expires 30d;
        add_header X-Content-Type-Options nosniff always;
    }
    location /private_media/ { return 404; }
    location / {
        proxy_pass http://127.0.0.1:8041;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
