# Desenvolvimento local. Gere sua chave; nunca use este valor em produção.
DJANGO_SECRET_KEY=gere-uma-chave-aleatoria-com-pelo-menos-50-caracteres
DJANGO_DEBUG=True
DJANGO_DB_ENGINE=sqlite
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Produção: DJANGO_DEBUG=False e DJANGO_DB_ENGINE=postgresql
# DJANGO_ALLOWED_HOSTS=jumbi.nabio.pro
# DJANGO_CSRF_TRUSTED_ORIGINS=https://jumbi.nabio.pro
# JUMBI_PRIVATE_MEDIA_ROOT=/srv/jumbi/shared/private_media
POSTGRES_DB=jumbi
POSTGRES_USER=jumbi
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
